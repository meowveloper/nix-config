alias ls='eza -l --color=auto --group-directories-first --icons=auto'
alias la='eza -la --color=auto --group-directories-first --icons=auto'
alias l='eza -laa --color=auto --group-directories-first --icons=auto'
alias tree='eza --tree'

alias nn='nvim .'
alias n='nvim'
alias ff='fastfetch'

alias gg='lazygit'

alias cat='bat'
alias grep='rg'
alias find='fd'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias df='duf'

# Cloud Mounts
alias mount-secret='systemctl --user start rclone-secret.service'
alias umount-secret='systemctl --user stop rclone-secret.service'
alias mount-gdrive='systemctl --user start rclone-gdrive.service'
alias umount-gdrive='systemctl --user stop rclone-gdrive.service'
alias umount-cloud='systemctl --user stop rclone-secret.service rclone-gdrive.service'

# opencode2 service
alias opc='opencode2 service start && sudo tailscale serve --bg http://127.0.0.1:$(opencode2 service get port)'
alias opcs='opencode2 service stop && sudo tailscale serve --https=443 off'
alias opcrs='opencode2 service restart && sudo tailscale serve --https=443 off && sudo tailscale serve --bg http://127.0.0.1:$(opencode2 service get port)'
alias opcst='opencode2 service status && tailscale serve status'
alias opc2='opencode2'
