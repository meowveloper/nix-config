alias ls='eza -l --color=auto --group-directories-first --icons=auto'
alias la='eza -la --color=auto --group-directories-first --icons=auto'
alias l='eza -laa --color=auto --group-directories-first --icons=auto'
alias tree='eza --tree'

alias nn='nvim .'
alias n='nvim'
alias ff='fastfetch'

alias gg='lazygit'

alias cat='bat'
alias grep='rg'
alias find='fd'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias df='duf'

# Cloud Mounts
alias mount-secret='systemctl --user start rclone-secret.service'
alias umount-secret='systemctl --user stop rclone-secret.service'
alias mount-gdrive='systemctl --user start rclone-gdrive.service'
alias umount-gdrive='systemctl --user stop rclone-gdrive.service'
alias umount-cloud='systemctl --user stop rclone-secret.service rclone-gdrive.service'

# opencode service
alias opc1='systemctl --user start opencode-web'
alias opc1s='systemctl --user stop opencode-web'
alias opc1rs='systemctl --user restart opencode-web'
alias opc1at='opencode attach http://localhost:4096'

# opencode2 service
alias opc='opencode2 service start'
alias opcs='opencode2 service stop'
alias opcrs='opencode2 service restart'
alias opcpw='cat $HOME/.config/opencode/service.json'
