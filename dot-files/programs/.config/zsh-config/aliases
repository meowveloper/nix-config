alias ls='eza -l --color=auto --group-directories-first --icons=auto'
alias la='eza -la --color=auto --group-directories-first --icons=auto'
alias l='eza -laa --color=auto --group-directories-first --icons=auto'
alias tree='eza --tree'

alias nn='nvim .'
alias n='nvim'
alias ff='fastfetch'

alias gg='lazygit'

alias cat='bat'
alias grep='rg'
alias find='fd'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias df='duf'

# Cloud Mounts
alias mount-secret='systemctl --user start rclone-secret.service'
alias umount-secret='systemctl --user stop rclone-secret.service'
alias mount-gdrive='systemctl --user start rclone-gdrive.service'
alias umount-gdrive='systemctl --user stop rclone-gdrive.service'
alias umount-cloud='systemctl --user stop rclone-secret.service rclone-gdrive.service'

# opencode2 service
alias opc='opencode service start && sudo tailscale serve --bg http://127.0.0.1:$(opencode service get port)'
alias opcs='opencode service stop && sudo tailscale serve --https=443 off'
alias opcrs='opencode service restart && sudo tailscale serve --https=443 off && sudo tailscale serve --bg http://127.0.0.1:$(opencode service get port)'
alias opcst='opencode service status && tailscale serve status'
alias opct='opencode'

# dsh web service (manual systemd unit dsh-web.service, port 3080)
alias dshw='systemctl --user start dsh-web.service'
alias dshws='systemctl --user stop dsh-web.service'
alias dshwrs='systemctl --user restart dsh-web.service'
alias dshwst='systemctl --user status dsh-web.service'
alias dshwlog='journalctl --user -u dsh-web.service -f'
alias dshwt='dsh web --no-open --port 3080'
