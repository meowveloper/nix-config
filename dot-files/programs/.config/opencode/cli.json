{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "session": {
    "sidebar": "hide",
    "terminal": true
  },
  "tabs": {
    "layout": "vertical",
    "indicators": "status"
  },
  "prompt": {
    "image_preview": true
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": false
  },
  "keybinds": {
    "session.tab.next": "ctrl+j",
    "session.tab.previous": "ctrl+k"
  }
}
