{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "subagent-manager",
    "plugin": ["opencode-gemini-auth@latest"],
    "mcp": {
        "firecrawl": {
            "type": "local",
            "command": ["npx", "-y", "firecrawl-mcp"],
            "environment": {
                "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
            }
        }
    }
}
