{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "orchestrator",
    "mcp": {
        "chrome": {
            "type": "local",
            "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222"],
            "enabled": true
        }
    }
}
