{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "orchestrator",
    "mcp": {
        "playwright": {
            "type": "local",
            "command": ["playwright-mcp", "--browser", "chromium", "--user-data-dir", "{env:HOME}/.cache/playwright-mcp-profile"],
            "environment": {
                "PLAYWRIGHT_MCP_USER_DATA_DIR": "{env:HOME}/.cache/playwright-mcp-profile"
            },
            "enabled": true
        },
        "composio": {
            "type": "remote",
            "url": "https://connect.composio.dev/mcp",
            "headers": {
                "x-consumer-api-key": "{env:COMPOSIO_API_KEY}"
            }
        }
        "browser-harness": {
            "type": "local",
            "command": ["uvx", "--python", "3.12", "--from", "browser-harness[mcp]", "browser-harness-mcp"],
            "enabled": true
            // remove instructions
            // rm -rf ~/.cache/uv              # the uvx temporary box
            // rm -rf ~/.local/share/uv        # IMPORTANT: includes tools/ AND python/3.12 - this is the big one
            // rm -f ~/.local/bin/uvx ~/.local/bin/browser-harness*  # shims, if any
            // rm -rf ~/.config/browser-harness # logs, screenshots, auth
        }
    },
    "provider": {
    }
}
