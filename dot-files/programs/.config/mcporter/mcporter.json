{
    "mcpServers": {
        "composio": {
            "baseUrl": "https://connect.composio.dev/mcp",
            "lifecycle": "keep-alive"
        },
        "classifier": {
            "baseUrl": "https://classifier.dev/mcp",
            "lifecycle": "keep-alive"
        },
        "classifier-docs": {
            "baseUrl": "https://classifier.dev/mcp/docs",
            "lifecycle": "keep-alive"
        },
        "browser_harness": {
            "command": "uvx",
            "args": [
                "--python",
                "3.12",
                "--from",
                "browser-harness[mcp]",
                "browser-harness-mcp"
            ],
            "lifecycle": "keep-alive"
        }
    }
}
